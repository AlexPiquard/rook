<?xml version="1.0" encoding="UTF-8"?>
<!-- Alex Piquard 2019 <alex.piquard@hotmail.com> -->
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0</metadata_license>
  <!-- Insert your license of choice here -->
  <!-- <project_license>MIT</project_license> -->
  <name>Rook</name>
  <summary>Simple email client for Linux</summary>
  <description>
    <p>A simple email client for Linux.</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://github.com/AlexPiquard/rook/raw/main/data/resources/screenshots/screenshot1.png</image>
      <caption>Main window</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/AlexPiquard/rook</url>
  <url type="bugtracker">https://github.com/AlexPiquard/rook/issues</url>
  <!-- Source code repository -->
  <url type="vcs-browser">https://github.com/AlexPiquard/rook</url>
  <!-- Translation repository -->
  <url type="translate">https://github.com/AlexPiquard/rook/tree/main/po</url>
  <!-- Open Age Ratings Service:
       https://hughsie.github.io/oars/generate.html
  -->
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.1.0" date="2026-11-26" />
  </releases>
  <kudos>
     <!--
       GNOME Software kudos:
       https://gitlab.gnome.org/GNOME/gnome-software/-/blob/main/doc/kudos.md
     -->
     <kudo>ModernToolkit</kudo>
     <kudo>HiDpiIcon</kudo>
  </kudos>
  <!-- developer_name tag deprecated with Appstream 1.0 -->
  <developer_name translate="no">Alex Piquard</developer_name>
  <!-- Introduced with Appstream 1.0, but not yet fully supported by corresponding projects -->
  <developer id="gnome.org">
    <name translate="no">Alex Piquard</name>
  </developer>
  <!-- 
    Branding colors:
    https://docs.flathub.org/docs/for-app-authors/metainfo-guidelines/#brand-color
  -->
  <branding>
    <color type="primary" scheme_preference="light">#ff00ff</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>  
  <update_contact>alex.piquard@hotmail.com</update_contact>
  <translation type="gettext">@gettext-package@</translation>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
</component>
